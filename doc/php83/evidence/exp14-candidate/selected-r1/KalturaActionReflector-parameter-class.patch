+	/** Resolve the class component with the legacy getClass() semantics. */
+	private static function getParameterClass(ReflectionParameter $parameter)
+	{
+		$type = $parameter->getType();
+		if ($type instanceof ReflectionNamedType)
+			$types = array($type);
+		else if ($type instanceof ReflectionUnionType)
+			$types = $type->getTypes();
+		else
+			return null;
+
+		$className = null;
+		foreach ($types as $member)
+		{
+			if (!($member instanceof ReflectionNamedType))
+				return null;
+			if ($member->isBuiltin())
+				continue;
+			if ($className !== null)
+				return null;
+			$className = $member->getName();
+		}
+		if ($className === null)
+			return null;
+		if (strcasecmp($className, 'self') === 0)
+			return $parameter->getDeclaringClass();
+		if (strcasecmp($className, 'parent') === 0)
+		{
+			$parent = $parameter->getDeclaringClass()->getParentClass();
+			if (!$parent)
+				throw new ReflectionException("Parameter uses 'parent' as type hint although class does not have a parent!");
+			return $parent;
+		}
+		return new ReflectionClass($className);
+	}
