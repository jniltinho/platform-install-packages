          "line": 332,
          "text": "  public static function get_files_from_argument($arg, $target_dir = '', $relative = false)"
        },
        {
          "line": 333,
          "text": "  {"
        },
        {
          "line": 334,
          "text": "    $files = array();"
        },
        {
          "line": 335,
          "text": "    if (is_array($arg))"
        },
        {
          "line": 336,
          "text": "    {"
        },
        {
          "line": 337,
          "text": "      $files = $arg;"
        },
        {
          "line": 338,
          "text": "    }"
        },
        {
          "line": 339,
          "text": "    else if (is_string($arg))"
        },
        {
          "line": 340,
          "text": "    {"
        },
        {
          "line": 341,
          "text": "      $files[] = $arg;"
        },
        {
          "line": 342,
          "text": "    }"
        },
        {
          "line": 343,
          "text": "    else if ($arg instanceof pakeFinder)"
        },
        {
          "line": 344,
          "text": "    {"
        },
        {
          "line": 345,
          "text": "      $files = $arg->in($target_dir);"
        },
        {
          "line": 346,
          "text": "    }"
        },
        {
          "line": 347,
          "text": "    else"
        },
        {
          "line": 348,
          "text": "    {"
        },
        {
          "line": 349,
          "text": "      throw new pakeException('Wrong argument type (must be a list, a string or a pakeFinder object).');"
        },
        {
          "line": 350,
          "text": "    }"
        },
        {
          "line": 351,
          "text": ""
        },
        {
          "line": 352,
          "text": "    if ($relative && $target_dir)"
        },
        {
          "line": 353,
          "text": "    {"
        },
        {
          "line": 354,
          "text": "      $files = preg_replace('/^'.preg_quote(realpath($target_dir), '/').'/', '', $files);"
        },
        {
          "line": 355,
          "text": ""
        },
        {
          "line": 356,
          "text": "      // remove leading /"
        },
        {
          "line": 357,
          "text": "      $files = array_map(create_function('$f', 'return 0 === strpos($f, DIRECTORY_SEPARATOR) ? substr($f, 1) : $f;'), $files);"
