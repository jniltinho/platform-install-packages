# Ubuntu 24.04 (noble): VM "build" gera os .deb, VM "aio" instala e testa o All-In-One.
Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.synced_folder "../..", "/vagrant"

  config.vm.define "build" do |b|
    b.vm.hostname = "kaltura-build"
    b.vm.provider("virtualbox") { |v| v.memory = 8192; v.cpus = 8 }
    b.vm.provision "shell", path: "build.sh", privileged: false
  end

  config.vm.define "aio", autostart: false do |a|
    a.vm.hostname = "kaltura.local"
    a.vm.network "private_network", ip: "192.168.56.20"
    a.vm.provider("virtualbox") { |v| v.memory = 8192; v.cpus = 4 }
    a.vm.provision "shell", path: "install-aio.sh"
    a.vm.provision "shell", path: "sanity.sh", run: "always"
  end
end
