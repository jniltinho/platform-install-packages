# Ubuntu 26.04: VM "build2604" builds the .deb packages, VM "aio2604" installs and tests the All-In-One.
Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-26.04"
  config.vm.synced_folder "../..", "/vagrant"

  config.vm.define "build2604" do |b|
    b.vm.hostname = "kaltura-build2604"
    b.vm.provider("virtualbox") { |v| v.memory = 8192; v.cpus = 8 }
    b.vm.provision "build", type: "shell", path: "build.sh", privileged: false
  end

  config.vm.define "aio2604", autostart: false do |a|
    a.vm.hostname = "kaltura2604"
    a.vm.network "private_network", ip: "192.168.56.40"
    a.vm.provider("virtualbox") { |v| v.memory = 8192; v.cpus = 4 }
    a.vm.provision "install", type: "shell", path: "install-aio.sh"
    a.vm.provision "sanity", type: "shell", path: "sanity.sh", run: "always"
  end
end
